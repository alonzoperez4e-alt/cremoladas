# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - CREMOLADAS BACKEND
# ==============================================================================
# Copie este archivo como .env y complete los valores correspondientes.

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto donde correrá el servidor HTTP (por defecto: 4000)
PORT=4000

# Cadena de conexión a Neon PostgreSQL (con SSL requerido)
# Ejemplo: postgresql://[usuario]:[contraseña]@[endpoint].neon.tech/[basededatos]?sslmode=require
DATABASE_URL=postgresql://usuario:contraseña@ep-sample-123456.us-east-2.aws.neon.tech/cremoladas_db?sslmode=require

# Secreto para firma de JWT (mínimo 32 caracteres obligatorios)
# Puede generar uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_must_be_at_least_32_characters_long

# Tiempo de expiración del JWT (ej: 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS (soporta lista separada por comas)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Configurar si la aplicación está detrás de un proxy inverso (Render, Railway, Fly, Nginx, etc.)
# Valores posibles: true, false, o el número de proxies intermedios (ej: 1)
TRUST_PROXY=false

# Rate Limit para login (máximo de intentos por IP dentro de la ventana de tiempo)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MINS=15

# Rate Limit global para la API (máximo de peticiones por IP dentro de la ventana de tiempo)
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MINS=15

# ==============================================================================
# VARIABLES PARA SEED DE ADMINISTRADOR (scripts/seed-admin.js)
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CambiarEstaClaveSegura123!
ADMIN_FULL_NAME=Administrador del Sistema
